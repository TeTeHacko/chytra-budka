# Copy to .env and adjust. Secrets live in $BUDKA_SECRETS_DIR (see
# scripts/init-secrets.sh), never in this file.

# Base domain — the stack serves budka.<domain>, ota.<domain>, mqtt.<domain>.
BUDKA_DOMAIN=example.com

# Let's Encrypt account e-mail (scripts/issue-le-cert.sh).
LE_EMAIL=admin@example.com

# Where secret files live (bind-mounted into containers). On Portainer point
# this at a host directory you provisioned once, e.g. /srv/budka/secrets.
BUDKA_SECRETS_DIR=./secrets

# Published ports / bind addresses. Defaults are production-shaped; remap for
# local dev if the host already uses 80/443 (e.g. HTTP_PORT=8081).
#HTTP_BIND=0.0.0.0
#HTTP_PORT=80
#HTTPS_BIND=0.0.0.0
#HTTPS_PORT=443
#MQTT_TLS_BIND=0.0.0.0
#MQTT_TLS_PORT=8883
# Ops listener (TLS+password). Bind to a LAN/VPN address if you don't want it public.
#MQTT_OPS_BIND=0.0.0.0
#MQTT_OPS_PORT=8884

# RTSP read endpoint for the external BirdNET-Go (loopback by default —
# widen to a LAN address where BirdNET-Go runs on another host).
#RTSP_BIND=127.0.0.1
#RTSP_PORT=8554

# Exporter scrape binding (host Alloy convention: loopback + file_sd).
#METRICS_BIND=127.0.0.1
#CBPROM_PORT=9878
