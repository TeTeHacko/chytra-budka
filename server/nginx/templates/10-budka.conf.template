# budka.<domain>: management UI/API (manager), device push ingest, audio relay.
# Upstreams are referenced via variables + the embedded docker DNS resolver so
# nginx starts (and keeps serving other vhosts) even while a backend is down —
# important because manager/relay arrive in later phases of the buildout.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 443 ssl;
    http2 on;
    server_name budka.${BUDKA_DOMAIN};

    ssl_certificate     /certs/le/fullchain.pem;
    ssl_certificate_key /certs/le/privkey.pem;

    resolver 127.0.0.11 valid=30s;

    # Devices POST VAD audio bursts here (chunked); proxy straight through.
    location /audio/ {
        set $relay_upstream http://relay:8765;
        proxy_pass $relay_upstream;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        client_max_body_size 0;
    }

    # Devices POST MJPEG push streams here (chunked multipart).
    location /ingest/ {
        set $manager_upstream http://manager:8080;
        proxy_pass $manager_upstream;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        client_max_body_size 0;
    }

    # Everything else: manager (SPA, REST API, WebSocket, MJPEG fan-out).
    location / {
        set $manager_upstream http://manager:8080;
        proxy_pass $manager_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
