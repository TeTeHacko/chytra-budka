[Unit]
Description=Chytrá Budka audio relay (HTTP→RTSP)
After=network-online.target mediamtx.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=birdnet
Group=birdnet
WorkingDirectory=/opt/chytra-budka-relay
EnvironmentFile=/etc/chytra-budka/relay.env
ExecStart=/opt/chytra-budka-relay/.venv/bin/python relay.py --config /etc/chytra-budka/relay.toml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
TimeoutStopSec=15
KillSignal=SIGTERM

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
PrivateDevices=yes
# Relay + its ffmpeg child only need TCP (HTTP in, RTSP out) + local sockets.
# NOTE: verify a live stream after deploy — if ffmpeg needs another family
# this is the first place to widen.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Logs go to journal; no filesystem writes needed.

[Install]
WantedBy=multi-user.target
