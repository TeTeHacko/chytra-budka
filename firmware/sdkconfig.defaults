# Chytrá Budka — base sdkconfig.defaults (target-agnostic).
# Target-specific overrides go in sdkconfig.defaults.<target>.
#
# Security flags (Secure Boot v2, Flash Encryption, NVS Encryption) are kept
# disabled here so the first bring-up works without signing keys / eFuse burns.
# They are enabled in a follow-up commit (see tools/setup_keys.sh + production
# sdkconfig overlay) before the firmware is flashed onto a deployed unit.

# ─── Logging ──────────────────────────────────────────────────────────────
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_EQUALS_DEFAULT=y
CONFIG_LOG_COLORS=y

# ─── Compiler ─────────────────────────────────────────────────────────────
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_RTTI=n

# ─── Networking (lwIP) ────────────────────────────────────────────────────
# BSD-socket (netconn) ceiling. Was 10, which was the lone bottleneck: the
# concurrent consumers — HTTPS :443 (4) + HTTP→HTTPS redirect :80 (3) + MQTT (1)
# + the persistent audio-relay stream (1) ≈ 9 baseline — left almost nothing for
# photo-upload / GlitchTip / OTA / DNS bursts, so under heavy load (the bench
# wedge during OTA traffic) socket() started failing → "Error transport connect"
# loops with no escape. MAX_ACTIVE_TCP is already 16, so raise this to match:
# the TCP layer could always do 16, only the netconn layer capped at 10. Each
# added netconn is ~a few hundred bytes of internal DRAM (negligible vs the
# ~150 KB free), and the net watchdog still backstops any residual exhaustion.
CONFIG_LWIP_MAX_SOCKETS=24
CONFIG_LWIP_TCP_MSS=1440
CONFIG_LWIP_SO_LINGER=y
CONFIG_LWIP_TCP_KEEPALIVE=y
# Custom impl of lwip_dhcp_on_extra_option in wifi_mgr.c captures DHCP
# option 15 (Domain Name) for tls_enroll's FQDN construction. See
# HTTPS.md "Domain discovery".
CONFIG_LWIP_HOOK_DHCP_EXTRA_OPTION_CUSTOM=y

# ─── mbedTLS ──────────────────────────────────────────────────────────────
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
# Allocate mbedTLS working memory (per-session ~40 KB: record buffers, SSL
# ctx, cert-chain parse) in PSRAM instead of internal DRAM. Internal DRAM is
# the scarce resource (~150 KB free at boot) and was the hard cap on
# concurrent TLS connections — with INTERNAL alloc, >4 HTTPS sockets OOM'd
# mbedtls_ssl_setup. Routing to the 8 MB PSRAM lifts that ceiling so the
# server survives real browser parallelism (several parallel conns per page
# + a 5-min MJPEG stream pinning a socket). HW-crypto DMA buffers still come
# from internal/DMA-capable RAM via the IDF mbedtls port. TLS1.3 kept (no
# downgrade); this is a capacity fix, bench-stress validated.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Precompute EC base-point comb tables: speeds ECDHE keygen + ECDSA (~30%
# faster TLS handshakes), which is the dominant cost of a COLD connection and
# the only remaining lever on handshake-serialization tail latency (esp-httpd
# does handshakes serially in its single task). Costs a few KB of tables —
# which now land in PSRAM via EXTERNAL_MEM_ALLOC above, so internal DRAM is
# unaffected. No protocol change (not a downgrade).
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
# X.509 CSR + cert WRITING (needed by tls_enroll.c for the device's
# self-signed CSR built before sending to the cbd-enroll signer).
# Default in v6.0.1 is OFF (MBEDTLS_X509_CREATE_C defaults n) — has
# to be opted into explicitly.
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CSR_WRITE_C=y
# NOTE: CONFIG_MBEDTLS_DYNAMIC_BUFFER is deliberately left OFF.
# It was tried as a fix for TLS 1.3 rapid-reconnect OOM (seen on the old
# v5.5 / mbedtls 3.6.6 stack), but on v6.0.1 / mbedtls 4.0.0 the dynamic
# input buffer is NULL when the TLS 1.3 server parses the ClientHello
# record header (ssl_msg.c ssl_parse_record_header) → LoadProhibited
# crash on every HTTPS handshake (bench-verified 2026-05-29). With it
# OFF and max_open_sockets=4 (http_server.c), 15/15 rapid TLS 1.3
# handshakes succeed with no OOM and no crash — the 3.6.6-era OOM does
# not reproduce on 4.0.0. Do not re-enable without re-testing the
# handshake path on the bench.
CONFIG_MBEDTLS_HAVE_TIME=y
CONFIG_MBEDTLS_HAVE_TIME_DATE=y
# HW-AES kept ON (lower power — esp_aes near-zero CPU vs software aes.c on a
# solar/battery box). KNOWN trade-off: esp_aes needs a DMA-capable INTERNAL-DRAM
# buffer per op, and with BLE-on the largest free internal block is tight
# (~4-6 KB), so under concurrent bulk TLS the alloc can fail → "esp-aes: Failed
# to allocate memory" (GlitchTip CHYTRA-BUDKA-QK) — a non-crash DEGRADATION (the
# TLS op retries). Disabling HW-AES (software aes.c, no DMA buffer) was bench-
# tested and frees ~2 KB contiguous DMA + kills the OOM, but costs CPU/power;
# rejected for the field's low-rate-TLS duty cycle. Revisit if the OOM rate hurts
# real telemetry/uploads (not just the synthetic soak).
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
# Use a custom certificate bundle (only ISRG Root X1/X2 for *.example.com LE chain)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="tools/le_isrg_roots.pem"

# ─── ESP HTTPS / OTA ──────────────────────────────────────────────────────
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n
CONFIG_OTA_ALLOW_HTTPS_OTA_DECRYPT_CB=y
# esp_https_server: TLS-protected HTTP server on :443 once tls_store has
# a cert. The factory image without a cert still falls back to plain
# :80 (see http_server.c). HTTPS.md "Phased migration" E4.
CONFIG_ESP_HTTPS_SERVER_ENABLE=y

# ─── Power management ─────────────────────────────────────────────────────
# DFS interacts badly with LCD_CAM XCLK on the S3 — see comment in
# sdkconfig.defaults.esp32s3. Until we wire esp_pm_lock_t around the
# camera + audio paths, keep PM and tickless idle off in the base too
# so the final config doesn't depend on overlay ordering. The base used
# to enable PM and the s3 overlay disabled it back, which left every
# reader wondering which won.
# CONFIG_PM_ENABLE is not set
# CONFIG_PM_DFS_INIT_AUTO is not set
# CONFIG_FREERTOS_USE_TICKLESS_IDLE is not set

# Per-task introspection for /debug/cores. TRACE_FACILITY enables
# uxTaskGetSystemState() + TaskStatus_t; STATS_FORMATTING gives us the
# vTaskList()/vTaskGetRunTimeStats() formatters used by the same
# endpoint for human-readable output. Both are cheap (a few KB Flash,
# no runtime cost). RUN_TIME_STATS — which would populate
# runtime_pct — is intentionally NOT enabled here because it adds ~5%
# context-switch overhead on every task switch. Operators turn it on
# ad-hoc via menuconfig on a bench build when they want utilization
# distribution, then turn it off again before flashing field units.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
# Populate TaskStatus_t::xCoreID so /debug/cores can report each task's
# pinned core directly. Cheap (1 field per task in the snapshot buffer).
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS is not set

# ─── NVS ──────────────────────────────────────────────────────────────────
# NVS encryption requires Flash Encryption — enabled in production overlay.
# CONFIG_NVS_ENCRYPTION=y

# ─── Partition table ──────────────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
# Partition table at 0x10000 for ALL profiles (the fleet-standard layout).
# WHY here (base) and not per-profile: the field board's HW Secure Boot v2
# bootloader is too big for the stock 0x8000 head, so it MUST be 0x10000 — and
# a single OTA image only boots if the table offset matches the board's flashed
# offset. So bench + field + every profile share 0x10000. On a non-Secure-Boot
# board (bench) the only cost is ~32 KB of unused flash before the table —
# nothing on 8 MB. partitions.csv (auto-computed offsets) already assumes this
# "0x10000 head". Previously this lived only in .field/.secureboot_test, so
# `build.sh bench` silently produced a 0x8000 image that mismatched the fleet
# and broke HIL-then-OTA — unified here so the default 0x8000 can't sneak back.
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# ─── App ──────────────────────────────────────────────────────────────────
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Strip absolute build/source paths from the binary so the same commit produces
# the same ELF (and app_elf_sha256) regardless of WHERE it's built. A field
# coredump records the app's ELF-SHA256 and esp-coredump is fail-closed: without
# the byte-identical ELF it refuses to symbolize. Reproducible builds mean we can
# rebuild the exact ELF for any commit and decode a field/bench panic — which we
# could NOT do for the e8fa1dc coredump (built at a one-off path, ELF since gone).
CONFIG_APP_REPRODUCIBLE_BUILD=y

# ─── Panic handler robustness ─────────────────────────────────────────────
# Diagnosing intermittent "other_wdt + coredump:false" resets: the real
# panic recurses inside the panic handler (panic handler entered multiple
# times) and the bootloader-grade RTC WDT fires before coredump finishes
# writing. Three knobs help:
#
#   * Put the panic handler in IRAM so it survives the cache-disabled
#     window during flash writes / OTA / DMA-driven traffic.
#   * Triple the coredump worker stack: at 1792 B the default barely
#     fits with PSRAM-tracking metadata, and a stack overflow inside
#     the dumper itself is exactly what produces the recursive-panic
#     symptom we see.
#   * Stretch the bootloader / RTC WDT to 30 s so the coredump
#     writer actually finishes flushing to flash.
#
# Originally we also enabled CAPTURE_DRAM to ship global state alongside
# stacks, but the coredump partition is only 64 KB and ESP32-S3 DRAM is
# ~320 KB — the dump silently truncated or CRC-failed. Bumping the
# partition would require a destructive reflash of fielded boards, so
# we stick with task stacks (default behaviour) which catch >95 % of
# faults in this firmware. To re-enable DRAM capture, partition.csv
# needs coredump grown to 0x40000 first.
CONFIG_ESP_PANIC_HANDLER_IRAM=y
CONFIG_ESP_COREDUMP_STACK_SIZE=4096
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set
CONFIG_BOOTLOADER_WDT_TIME_MS=30000

# ─── FreeRTOS — main task stack ──────────────────────────────────────────
# Default 3584 B was overflowed in the field: glitchtip_report's 1 KB
# event_t + 512 B local buffers + audio/camera/telemetry call chains
# blew the canary and triggered a self-sustaining crash loop (179+
# consecutive boots before the heap-alloc fix in glitchtip.c). 5120 B
# leaves a comfortable margin even with future hot-path additions.
# Stack-intensive one-shot work (TLS enrollment's mbedtls SHA-512 +
# X.509 verify chain) runs in a dedicated 12 KB task — see
# tls_enroll.c::tls_boot_enroll_if_needed — so we don't permanently
# pay for that headroom on the main task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=5120
