# Production security overlay — applied on top of the base + target defaults.
#
# Build with:
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.esp32s3;sdkconfig.defaults.production" \
#          -B build-prod build
#
# Prerequisites: run tools/setup_keys.sh once to generate signing/encryption
# keys (stored in ~/.config/chytra-budka/keys, symlinked as firmware/keys/).
#
# WARNING: First flash with these settings burns eFuses irreversibly. Read
# README.md → "Production hardening" before running idf.py flash.

# ─── Secure Boot v2 (RSA-3072) ────────────────────────────────────────────
# In-tree signing by default. To use YubiKey / HSM external signing, stack
# `sdkconfig.defaults.production_yubikey` after this overlay (it flips
# BUILD_SIGNED_BINARIES off and points at the public-only PEM).
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_RSA_SCHEME=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="keys/secure_boot_signing_key.pem"
CONFIG_SECURE_BOOT_INSECURE=n

# Keep both unused Secure Boot key digest slots usable. The README §post-quantum
# migration path is: when ML-DSA Secure Boot ships (likely IDF v6.x/v7.0), a
# bridge firmware OTA burns the new ML-DSA public-key digest into one of the
# spare eFuse SB key slots. Revoking them now (KEY_REVOKE1/2=y) is irreversible
# and would destroy that migration vehicle for every fielded device. Revocation
# stays available as an emergency response to key compromise; it is not a
# hardening default. Aggressive revocation also stays off — it can brick a
# device on transient flash errors during signature checks.
CONFIG_SECURE_BOOT_ENABLE_AGGRESSIVE_KEY_REVOKE=n

# ─── Flash Encryption (XTS-AES-256, release mode) ────────────────────────
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y
CONFIG_SECURE_FLASH_REQUIRE_ALREADY_ENABLED=n
CONFIG_SECURE_FLASH_ENCRYPTION_KEYSIZE_256=y

# ─── Disable insecure debug paths ─────────────────────────────────────────
CONFIG_SECURE_DISABLE_ROM_DL_MODE=y
CONFIG_SECURE_BOOT_ALLOW_JTAG=n
CONFIG_SECURE_BOOT_ALLOW_ROM_BASIC=n

# ─── NVS encryption (uses dedicated nvs_keys partition in partitions.csv) ─
CONFIG_NVS_ENCRYPTION=y

# ─── Anti-rollback (enforce monotonic app version) ────────────────────────
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
CONFIG_BOOTLOADER_APP_SECURE_VERSION=0
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ─── Signed OTA verification ──────────────────────────────────────────────
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=n
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=n

# ─── Smaller image (release builds optimize for size) ─────────────────────
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# ─── App-level: drop /debug/* HTTP endpoints from production builds ────────
# Dev default in Kconfig is y so bench work can hit /debug/hang etc. In
# production these are unauthenticated remote-wedge / SD-wipe primitives;
# `?confirm=yes` is not auth. Handlers + URI strings are stripped when n.
CONFIG_CHYTRA_BUDKA_DEBUG_ENDPOINTS=n

# ─── App-level: OTA poll period 6 h on field deployments ───────────────────
# Dev Kconfig default 300 s (5 min) is comfortable bench iteration; field
# units don't need anywhere near that — once every 6 hours is enough to
# pick up an emergency rollout and saves measurable WiFi airtime + battery
# over 90-day autonomous runs.
CONFIG_CHYTRA_BUDKA_OTA_PERIOD_S=21600
