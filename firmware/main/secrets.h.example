// secrets.h.example — copy to secrets.h and fill in real values
// secrets.h is gitignored

#pragma once

// WiFi station credentials baked into the build.
//   - Fill these in to PRE-PROVISION a board for a known network (fleet
//     flashing): the board boots straight into STA and connects, as before.
//   - Leave them as the "your-…" placeholder (or blank "") to ship an
//     UNPROVISIONED board: with no usable STA target it skips the doomed
//     association attempt and boots directly into the AP provisioning portal
//     (join "cb-<suffix>" — first-boot AP password is random, echoed on the
//     serial console / OLED QR; sticky AP default "chytrabudka" — open http://172.31.4.1/wifi,
//     enter the real network). A known-good set saved via that portal — or via
//     cmd/wifi — then takes precedence over whatever is baked here.
#define WIFI_SSID         "your-ssid"
#define WIFI_PASSWORD     "your-wifi-password"

#define OTA_PASSWORD      "your-ota-password"

#define MQTT_USER         "mqtt-user"
#define MQTT_PASSWORD     "your-mqtt-password"

// Bearer token sent to relay in HTTP Authorization header
#define RELAY_AUTH        "your-shared-secret"

// HTTP Basic auth gate for the local HTTP(S) server's sensitive endpoints
// (/mic.wav, /stream.mjpg, /last.jpg, /capture, /photo, /photos, /selftest, …).
// Default is the easy-to-type "cb"/"cb" so the gate is ON out of the box; the
// /config page nags (red banner) until you set a real login there at runtime
// (min 6 chars). Set these to the "your-…" placeholders instead to DISABLE the
// gate entirely. When enabled, the gate is enforced over HTTPS (once a cert is
// enrolled); over the plain-HTTP fallback / AP portal the homepage + /config +
// /wifi stay open (WPA2 on the AP is the access control there).
#define HTTP_BASIC_USER   "cb"
#define HTTP_BASIC_PASS   "cb"

// GlitchTip DSN — crash reporter sink (URL of the form
// https://<project-key>@<host>/<project-id>). A clean-clone build
// hard-fails if this is missing; for a no-crash-reporting setup,
// keep the placeholder so secret_is_placeholder() short-circuits the
// crash uploader at runtime.
#define GLITCHTIP_DSN     "https://your-glitchtip-key@your-host/0"
